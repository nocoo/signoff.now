{
	"name": "@signoff/web",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -p tsconfig.app.json --noEmit && vite build",
		"preview": "vite preview",
		"lint": "biome check --error-on-warnings .",
		"typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@signoff/domain": "workspace:*",
		"@nocoo/basalt": "2.1.7",
		"clsx": "^2.1.1",
		"lucide-react": "1.45.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-router": "8.3.1",
		"recharts": "3.10.1",
		"tailwind-merge": "3.7.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.5.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"@vitest/coverage-v8": "5.0.0",
		"happy-dom": "20.14.5",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.0",
		"vitest": "5.0.0"
	}
}
