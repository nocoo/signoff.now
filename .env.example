# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
# NEVER put real values in this file.
#
#   cp .env.example .env && chmod 600 .env

# ---------------------------------------------------------------------------
# CLI → production pipeline (ingest only)
# ---------------------------------------------------------------------------
# The machine host bypasses Cloudflare Access; this token is what authenticates.
# Set the matching Worker secret with:
#   bunx wrangler secret put SIGNOFF_PIPELINE_WRITE_TOKEN
SIGNOFF_API_BASE=https://signoff-ingest.hexly.ai
SIGNOFF_PIPELINE_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Automation → management API (CRUD)
# ---------------------------------------------------------------------------
# The pipeline token above only reaches the five MACHINE_ROUTES. Creating
# developers or repo bindings needs an Access identity, so use a service token
# rather than sharing a person's browser session.
#
# Zero Trust → Access → Service Auth → create a token, THEN add a "Service Auth"
# policy to the Application protecting signoff.hexly.ai and include that token.
# Creating the token alone is not enough — Access answers 302 until the policy
# exists (measured).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
