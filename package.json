{
	"name": "@signoff/repo",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^22.22.1 || ^24.0.0 || >=26.0.0"
	},
	"packageManager": "bun@1.4.0",
	"workspaces": [
		"packages/*",
		"apps/*",
		"tooling/*"
	],
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@playwright/test": "1.63.0",
		"@types/bun": "^1.4.2",
		"@vitest/coverage-v8": "^5.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"turbo": "^2.10.12",
		"typescript": "7.0.2",
		"vitest": "^5.0.0",
		"wrangler": "^4.131.1"
	},
	"scripts": {
		"dev": "turbo run dev --filter=@signoff/web",
		"dev:worker": "bun run db:migrate:local && bun run scripts/dev-worker.ts",
		"dev:collector": "bun run apps/collect/src/main.ts daemon",
		"dev:all": "FORCE_COLOR=1 bun run --no-orphans --parallel dev dev:worker dev:collector",
		"start:web": "bun run --cwd apps/web preview",
		"start:all": "bun run build:web && FORCE_COLOR=1 bun run --no-orphans --parallel start:web dev:worker dev:collector",
		"build:web": "turbo run build --filter=@signoff/web",
		"build": "turbo build",
		"test": "bun test scripts/dev-worker-health.test.ts scripts/dev-worker-log.test.ts && turbo test",
		"test:coverage": "bun test scripts/dev-worker-health.test.ts scripts/dev-worker-log.test.ts --coverage && turbo test:coverage",
		"lint": "bunx @biomejs/biome check --error-on-warnings .",
		"lint:fix": "bunx @biomejs/biome check --write --unsafe .",
		"format": "bunx @biomejs/biome format --write .",
		"typecheck": "tsc --noEmit && turbo typecheck",
		"prepare": "husky",
		"clean": "git clean -xdf node_modules",
		"clean:workspaces": "turbo clean",
		"security": "bun run scripts/run-security.ts",
		"gitinfo": "bun run apps/gitinfo/src/main.ts",
		"pulse": "bun run apps/pulse/src/main.ts",
		"signoff": "bun run apps/collect/src/main.ts",
		"db:migrate:local": "wrangler d1 migrations apply signoff-db --local",
		"db:seed:local": "bun run scripts/seed-demo.ts",
		"db:migrate:remote": "wrangler d1 migrations apply signoff-db --remote",
		"db:list:remote": "wrangler d1 migrations list signoff-db --remote",
		"test:e2e": "bun run scripts/test-e2e.ts"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,jsonc,css}": [
			"bunx @biomejs/biome check --write --error-on-warnings"
		]
	},
	"overrides": {
		"@babel/core": "^7.29.6",
		"brace-expansion": "^5.0.6",
		"esbuild": "^0.28.1",
		"form-data": "^4.0.6",
		"js-yaml": "^4.2.0",
		"nanoid": "^3.3.18",
		"postcss": "^8.5.23",
		"sharp": "^0.35.4",
		"tar": "^7.5.16",
		"tmp": "^0.2.6",
		"undici": "^6.28.0",
		"vite": "^8.3.0"
	},
	"patchedDependencies": {
		"@nocoo/basalt@2.1.8": "patches/@nocoo%2Fbasalt@2.1.8.patch"
	}
}
