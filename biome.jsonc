{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!**/*.template.js", "!**/*.template.sh"]
	},
	"formatter": {
		"formatWithErrors": true
	},
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"linter": {
		"rules": {
			"a11y": {
				"preset": "recommended"
			},
			"complexity": {
				"preset": "recommended",
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": { "maxAllowedComplexity": 40 }
				},
				"noExcessiveLinesPerFunction": "off",
				"noVoid": "off",
				"noForEach": "error",
				"noUselessUndefined": "error",
				"noImplicitCoercions": "off",
				"noDivRegex": "off"
			},
			"correctness": {
				"preset": "recommended",
				"useImportExtensions": "off",
				"noNodejsModules": "off",
				"noUndeclaredDependencies": "off",
				"noUnresolvedImports": "off",
				"noUndeclaredVariables": "off",
				"noSolidDestructuredProps": "off",
				"useQwikValidLexicalScope": "off",
				"noGlobalDirnameFilename": "off"
			},
			"performance": {
				"preset": "recommended",
				"useSolidForComponent": "off",
				"noBarrelFile": "off",
				"noReExportAll": "off",
				"noNamespaceImport": "off",
				"noSyncScripts": "off",
				"noJsxPropsBind": "off"
			},
			"security": {
				"preset": "recommended",
				"noSecrets": "off"
			},
			"style": {
				"preset": "recommended",
				"noNonNullAssertion": "error",
				"useConsistentArrayType": "error",
				"useForOf": "error",
				"noMagicNumbers": "off",
				"noImplicitBoolean": "off",
				"useBlockStatements": "off",
				"useExportsLast": "off",
				"useConsistentArrowReturn": "off",
				"noDefaultExport": "off",
				"noCommonJs": "off",
				"noProcessEnv": "off",
				"noEnum": "off",
				"noParameterProperties": "off",
				"noNegationElse": "off",
				"noNamespace": "off",
				"useFilenamingConvention": "off",
				"noJsxLiterals": "off",
				"useComponentExportOnlyModules": "off",
				"useConsistentObjectDefinitions": "off",
				"useConsistentMemberAccessibility": "off",
				"noInferrableTypes": "off",
				"noExportedImports": "off",
				"noHexColors": "off",
				"noTernary": "off",
				"noIncrementDecrement": "off",
				"noContinue": "off",
				"noExcessiveLinesPerFile": "off",
				"noExcessiveClassesPerFile": "off",
				"useDestructuring": "off",
				"useConsistentMethodSignatures": "off",
				"useErrorCause": "off",
				"useGlobalThis": "off"
			},
			"suspicious": {
				"preset": "recommended",
				"noReactSpecificProps": "off",
				"noConsole": "error",
				"noEmptyBlockStatements": "error",
				"noExplicitAny": "error",
				"useAwait": "off",
				"noArrayIndexKey": "error",
				"noEvolvingTypes": "off",
				"noLeakedRender": "error",
				"noShadow": "error",
				"useArraySortCompare": "error",
				"noEqualsToNull": "error",
				"noUnnecessaryConditions": "off",
				"noUndeclaredEnvVars": "off",
				"noNestedPromises": "error"
			},
			"nursery": {
				"preset": "recommended",
				"useSortedClasses": "off",
				"noFloatingPromises": "off",
				"useExplicitType": "off",
				"useExpect": "off",
				"useRegexpExec": "error",
				"noConditionalExpect": "off",
				"useAwaitThenable": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/*.spec.ts",
				"**/*.spec.tsx",
				"**/test-setup.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					},
					"suspicious": {
						"noConsole": "off",
						"noEmptyBlockStatements": "off",
						"useAwait": "off",
						"noExplicitAny": "off"
					},
					"nursery": {
						"noConditionalExpect": "off",
						"noFloatingPromises": "off"
					},
					"performance": {
						"noJsxPropsBind": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/web/public/learn/*.html"],
			"linter": {
				"rules": {
					"style": {
						"noDescendingSpecificity": "off"
					},
					"a11y": {
						"useHeadingContent": "off",
						"useAriaPropsSupportedByRole": "off",
						"noNoninteractiveTabindex": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/gitinfo/**", "apps/pulse/**", "scripts/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					},
					"correctness": {
						"noProcessGlobal": "off"
					}
				}
			}
		}
	]
}
